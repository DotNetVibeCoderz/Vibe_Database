<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CuteDB.Browser.App"
             RequestedThemeVariant="Dark">

  <!--
    Resources come before Styles, and must: a StaticResource used inside a style is resolved as the
    styles load, so a dictionary declared after them is not there yet. Getting this the wrong way
    round already cost the demo app next door an afternoon.
  -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://CuteBrowser/Theme/Tokens.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />

    <!--
      AvaloniaEdit's own theme. Without it the TextEditor has no control template at all and
      renders nothing — not the text, not the line-number margin, not even a caret. It looks
      exactly like an editor whose text failed to load, which is how it was missed the first time.
    -->
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />

    <!-- Ours last, so it wins over anything above it. -->
    <StyleInclude Source="avares://CuteBrowser/Theme/Styles.axaml" />
  </Application.Styles>

</Application>
