<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <RootNamespace>CuteDB.Cli.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Spectre.Console.Testing" />
    <PackageReference Include="Spectre.Console.Cli.Testing" />
  </ItemGroup>

  <!--
    The CLI is an executable, referenced like a library: the tests drive its command tree
    in-process through CliApp.Configure, which is far faster than spawning `cutedb` per case and
    lets a failure point at a line rather than at an exit code.
  -->
  <ItemGroup>
    <ProjectReference Include="../../src/CuteDB.Cli/CuteDB.Cli.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
