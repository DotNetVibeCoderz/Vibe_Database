<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
  </PropertyGroup>

  <!--
    Runtime tuning. The engine is a shared-nothing set of shards hammered by many threads, which is
    the workload server GC is built for: per-core heaps mean allocation on the request path does not
    serialise on a single allocation context. Left on for every project so a benchmark measures the
    same configuration a server actually runs.
  -->
  <PropertyGroup>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <!--
    Package identity, shared by the two shippable projects. Samples, tests and benchmarks opt out
    with IsPackable=false.

    PackageProjectUrl and RepositoryUrl point into the project's directory inside the Vibe_Database
    monorepo rather than at the repository root, because that is the page a reader should land on.
    This is a browse URL, not a clone URL - tooling that tries to `git clone` it will not work.
    RepositoryBranch records the branch unambiguously.
  -->
  <PropertyGroup>
    <Product>MemSharp</Product>
    <Company>Gravicode Studios</Company>
    <Authors>Gravicode Studios, Kang Fadhil</Authors>
    <Copyright>Copyright (c) 2026 Gravicode Studios</Copyright>
    <Version>1.0.0</Version>

    <PackageProjectUrl>https://github.com/DotNetVibeCoderz/Vibe_Database/tree/main/MemSharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/DotNetVibeCoderz/Vibe_Database/tree/main/MemSharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryBranch>main</RepositoryBranch>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageTags>redis;in-memory;database;cache;key-value;resp;pubsub;embedded;nosql</PackageTags>
  </PropertyGroup>

  <PropertyGroup>
    <PackageOutputPath>$(MSBuildThisFileDirectory)artifacts/packages</PackageOutputPath>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
