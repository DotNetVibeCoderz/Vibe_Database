<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <!--
      Avalonia is pinned at 11.3.13 rather than the newest 11.3.x because
      Avalonia.Controls.DataGrid — which the demo's advanced grid is built on — has no release
      past 11.3.13 on that line. Keeping every Avalonia package on one version avoids mixing
      assemblies that were never tested together.
    -->
    <AvaloniaVersion>11.3.13</AvaloniaVersion>
    <!--
      Pinned to 0.55.0 across all three Spectre packages because Spectre.Console.Cli — which the
      command routing is built on — has no release past that, while Spectre.Console itself has
      moved on to 0.57. Keeping them on one version avoids pairing a CLI host with a console
      library it was never compiled against.
    -->
    <SpectreVersion>0.55.0</SpectreVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- CLI -->
    <PackageVersion Include="Spectre.Console" Version="$(SpectreVersion)" />
    <PackageVersion Include="Spectre.Console.Cli" Version="$(SpectreVersion)" />
    <PackageVersion Include="Spectre.Console.Json" Version="$(SpectreVersion)" />

    <!-- Tests and benchmarks -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="LiteDB" Version="5.0.21" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />

    <!-- Avalonia demo and the offscreen screenshot renderer -->
    <PackageVersion Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Controls.DataGrid" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Diagnostics" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Headless" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Skia" Version="$(AvaloniaVersion)" />

    <!--
      CuteBrowser. AvaloniaEdit is on 11.3.0 rather than 11.4.x because it has to be built against
      the same Avalonia line as everything else here; mixing an editor compiled for 11.4 into an
      11.3 app is how a text control starts throwing on layout.
    -->
    <PackageVersion Include="Avalonia.AvaloniaEdit" Version="11.3.0" />
    <PackageVersion Include="AvaloniaEdit.TextMate" Version="11.3.0" />

    <!--
      The AI assistant. Semantic Kernel supplies the kernel, the function-calling loop and the
      OpenAI connector; the Anthropic service is written here rather than taken from the alpha
      connector, and Gemini and Ollama are reached through their OpenAI-compatible endpoints.
    -->
    <PackageVersion Include="Microsoft.SemanticKernel" Version="1.80.0" />
    <PackageVersion Include="System.Configuration.ConfigurationManager" Version="10.0.0" />

    <!-- The LINQ tab is a C# script, so it needs a C# compiler. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="4.14.0" />

    <!--
      Avalonia's Linux backend pulls in Tmds.DBus.Protocol, whose published versions carry an
      advisory; the fixed version is pinned directly. Mirrors the same pin in FAISS.Net.
    -->
    <PackageVersion Include="Tmds.DBus.Protocol" Version="0.21.3" />
  </ItemGroup>

</Project>
