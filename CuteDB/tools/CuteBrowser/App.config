<?xml version="1.0" encoding="utf-8" ?>
<!--
  CuteDB Browser configuration.
  Dibuat oleh Gravicode Studios, dipimpin oleh Kang Fadhil.

  Every value here is editable from Settings inside the app (Tools ▸ Settings), which writes back to
  this file. Editing it by hand works too; the app reads it at startup.

  API keys: leave them empty here and set them in the app, or supply them through environment
  variables instead — OPENAI_API_KEY, ANTHROPIC_API_KEY, GEMINI_API_KEY, OPENAI_COMPATIBLE_API_KEY,
  TAVILY_API_KEY. An
  environment variable wins over a blank setting and loses to one that is filled in, so a shared
  checkout never has to carry somebody's key.
-->
<configuration>
  <appSettings>

    <!-- ==================== the assistant ==================== -->

    <!-- openai | azureopenai | anthropic | gemini | ollama | compatible -->
    <add key="ai.provider" value="openai" />

    <!-- 0.0 is deterministic; 1.0 wanders. Query writing wants the low end. -->
    <add key="ai.temperature" value="0.2" />

    <!-- How many previous turns Jack sees. Older ones are dropped, the system prompt is not. -->
    <add key="ai.historyTurns" value="24" />

    <!-- Cap on how many times the model may call a tool before it has to answer. -->
    <add key="ai.maxToolCalls" value="8" />

    <add key="openai.model" value="gpt-4o" />
    <add key="openai.apiKey" value="" />
    <add key="openai.endpoint" value="https://api.openai.com/v1" />

    <add key="anthropic.model" value="claude-sonnet-5" />
    <add key="anthropic.apiKey" value="" />
    <add key="anthropic.endpoint" value="https://api.anthropic.com/v1" />

    <!-- Gemini is reached through its OpenAI-compatible endpoint, so one code path covers it. -->
    <add key="gemini.model" value="gemini-2.0-flash" />
    <add key="gemini.apiKey" value="" />
    <add key="gemini.endpoint" value="https://generativelanguage.googleapis.com/v1beta/openai/" />

    <!--
      Azure OpenAI. The model value is the DEPLOYMENT name, and the endpoint is the resource root
      (https://<resource>.openai.azure.com/) — not a /v1 path.
    -->
    <add key="azure.model" value="gpt-4o" />
    <add key="azure.apiKey" value="" />
    <add key="azure.endpoint" value="https://your-resource.openai.azure.com/" />

    <!--
      Anything else that speaks OpenAI's API: DeepSeek, Groq, Together, OpenRouter, a vLLM server.
      Set the endpoint and the model and it works through the same code path as OpenAI itself.
    -->
    <add key="compatible.model" value="deepseek-chat" />
    <add key="compatible.apiKey" value="" />
    <add key="compatible.endpoint" value="https://api.deepseek.com/v1" />

    <!-- Ollama needs no key. Point the endpoint at another machine to use its GPU. -->
    <add key="ollama.model" value="llama3.1" />
    <add key="ollama.apiKey" value="ollama" />
    <add key="ollama.endpoint" value="http://localhost:11434/v1" />

    <!--
      Jack's brief. The name matters: an assistant that introduces itself is easier to talk to than
      a text box, and one that states its limits is easier to trust.
    -->
    <add key="ai.systemPrompt" value="You are Jack — The Code Bender, the query assistant built into CuteDB Browser by Gravicode Studios. You help people read, write and repair CuteQL and LINQ against a CuteDB document database.

Work from what is actually there. Before writing a query, call list_collections and describe_collection to see the real field names — never guess a schema, and never invent a collection. Use validate_cuteql on anything you are about to hand over, and say so when it fails.

CuteQL is SQL-shaped with three differences worth remembering: a field path reaches into subdocuments (address.city), a field holding an array compares element-wise so `tags = 'promo'` means contains, and MISSING is a different question from NULL. There are no joins.

Answer in the language the person writes to you in. Put queries in a fenced block tagged cuteql or csharp so they can be dropped straight into a tab. Keep prose short — one or two sentences around the query is usually enough. If a request is ambiguous in a way that changes the query, ask rather than guessing." />

    <!-- ==================== tools ==================== -->

    <!-- Web search. Get a key at https://tavily.com; without one, search politely declines. -->
    <add key="tavily.apiKey" value="" />
    <add key="tavily.endpoint" value="https://api.tavily.com" />
    <add key="tools.web" value="true" />
    <add key="tools.maxScrapeChars" value="12000" />

    <!-- ==================== the workbench ==================== -->

    <add key="editor.showLineNumbers" value="true" />
    <add key="editor.fontSize" value="13.5" />
    <add key="editor.wordWrap" value="false" />

    <!-- Rows fetched into the grid at once. The engine still answers the whole query. -->
    <add key="results.pageSize" value="500" />

    <add key="explorer.width" value="300" />
    <add key="chat.visible" value="true" />
    <add key="chat.width" value="380" />
    <add key="logs.visible" value="true" />
    <add key="logs.height" value="150" />

    <!-- Reopened on the next launch. Cleared by File ▸ Close Database. -->
    <add key="workspace.lastDatabase" value="" />
    <add key="workspace.recent" value="" />

  </appSettings>
</configuration>
