<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <!--
    Package identity. Shared by both shippable libraries; samples, tests and benchmarks opt out
    with IsPackable=false in their own project files.

    RepositoryUrl points at the project's directory inside the Vibe_Database monorepo rather than
    at the repository root, because that is the page a reader should land on. Note that this is a
    browse URL, not a clone URL — tooling that tries to `git clone` RepositoryUrl will not work
    with it. RepositoryBranch is set so the branch is still recorded unambiguously.
  -->
  <PropertyGroup>
    <Product>FAISS.Net</Product>
    <Company>Gravicode Studios</Company>
    <Authors>Gravicode Studios, Kang Fadhil</Authors>
    <Copyright>Copyright (c) 2026 Gravicode Studios</Copyright>
    <Version>1.0.0</Version>

    <PackageProjectUrl>https://github.com/DotNetVibeCoderz/Vibe_Database/tree/main/FAISS.Net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/DotNetVibeCoderz/Vibe_Database/tree/main/FAISS.Net</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryBranch>main</RepositoryBranch>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>

  <!--
    Packing. Every package carries its own PACKAGE.md rather than the repository README, because
    NuGet renders the readme on a page where relative links and images do not resolve — the
    package readmes use absolute URLs into the repository instead.

    Symbols ship as .snupkg so a consumer can step into the library. Deterministic builds are on
    everywhere; ContinuousIntegrationBuild is set only in CI, where paths must be normalized.
  -->
  <PropertyGroup>
    <PackageOutputPath>$(MSBuildThisFileDirectory)artifacts/packages</PackageOutputPath>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
