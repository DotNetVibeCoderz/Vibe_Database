<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Faiss.Net.Gallery</RootNamespace>
    <AssemblyName>FAISS.Net.Gallery</AssemblyName>
    <IsPackable>false</IsPackable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.2" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.2" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.2" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Avalonia's Linux backend pulls in Tmds.DBus.Protocol, whose published versions carry an
      advisory. The Gallery is a Windows/macOS/Linux desktop sample and never touches DBus itself,
      but shipping a flagged transitive package is not acceptable, so the fixed version is pinned
      directly. Remove this once Avalonia's own dependency moves past it.
    -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Faiss.Net\Faiss.Net.csproj" />
  </ItemGroup>

</Project>
