<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Faiss.Net</RootNamespace>
    <AssemblyName>Faiss.Net</AssemblyName>
    <PackageId>Gravicode.FaissNet</PackageId>
    <Title>FAISS.Net — vector similarity search for .NET</Title>
    <Description>High-performance similarity search and clustering of dense vectors. A from-scratch .NET port of FAISS — no native binaries, no P/Invoke — built on Span&lt;T&gt; and SIMD intrinsics, with an API shaped like Python FAISS. Flat, IVF, HNSW, NSG, IMI, PQ, scalar, additive (RQ, LSQ), binary and sparse indexes; filtered search, re-ranking, lock-free concurrent reads, versioned and journaled persistence, memory-mapped search.</Description>
    <PackageTags>faiss;vector-search;similarity-search;ann;knn;nearest-neighbor;simd;embeddings;hnsw;ivf;product-quantization;rag;semantic-search</PackageTags>
    <PackageReadmeFile>PACKAGE.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>1.1.1: LocalSearchQuantizer training is now stable across seeds and CPU architectures (it starts from residual-quantizer codes and keeps its best codebooks; previously the final error depended on the seed and on the SIMD width). 1.1.0: filtered search (IDSelector, SearchParameters) inside the scan of every index; IndexRefine; searches while one writer adds, SynchronizedIndex, crash-safe PersistentIndex; HNSW over SQ and PQ storage, NSG, IMI, HNSW coarse quantizer with sink repair (FAISS #5705), RQ and LSQ additive quantizers, binary HNSW, sparse IndexSparseFlat; blocked GEMM flat search, precomputed IVFPQ tables, SIMD fp16 and 4-bit decode, parallel shard search, reducing OPQ, mini-batch k-means. Fixes: OPQ indexes failed to reload; seeded training was not reproducible. Benchmarked against FAISS 1.15.1: recall within two points everywhere.</PackageReleaseNotes>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573;CS0419</NoWarn>
    <Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <None Include="PACKAGE.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <!-- Generated by assets/render_icon.py. -->
    <None Include="..\..\assets\icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
